# Environment: "local" or "production"
ENV=local

# Gemini
# Preferred: AI Studio API key (free tier, no billing). Get one at https://aistudio.google.com/apikey
# Model: gemini-2.5-flash for quality, gemini-3.5-flash-lite for high-volume paths.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI fallback (only if GEMINI_API_KEY is unset)
# Use ADC credentials (local: GOOGLE_APPLICATION_CREDENTIALS, Cloud Run: runtime service account)
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1

# Local DB (ENV=local only)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=insafdaar_db
DB_USER=postgres
DB_PASSWORD=your-password

# Production Express proxy (ENV=production only)
# These MUST be set when ENV=production for contract drafting to work.
# EXPRESS_INTERNAL_URL: The internal URL of the Express backend (within Docker network: http://backend:5000)
# INTERNAL_API_KEY: Must match INTERNAL_API_KEY in webapp/.env for authentication
EXPRESS_INTERNAL_URL=http://backend:5000
INTERNAL_API_KEY=your-shared-secret-key

# RAG Assistant (Phase 2)
RAG_API_URL=https://your-rag-service.run.app

# Service config
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
